<!-- White clock glyph on a transparent background — the shape Android tints for
     the status-bar / notification small icon. Completes the "Clock" disguise. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- clock face ring -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M12,2.75 a9.25,9.25 0 1,0 0.01,0 z"/>
    <!-- hour hand -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,12 L12,7"/>
    <!-- minute hand -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,12 L16,13.5"/>
</vector>
